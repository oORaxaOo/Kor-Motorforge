{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kor-motorforge.dev/schemas/scene.schema.json",
  "title": "Kor Motorforge Scene",
  "description": "Version 1 scene document with stable scene/entity IDs and extensible components.",
  "type": "object",
  "required": ["schema_version", "scene", "entities"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scene": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "components"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "object",
            "properties": {
              "transform": {
                "type": "object",
                "required": ["x", "y", "rotation", "scale_x", "scale_y"],
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "rotation": {"type": "number"},
                  "scale_x": {"type": "number"},
                  "scale_y": {"type": "number"}
                },
                "additionalProperties": false
              },
              "sprite": {
                "type": "object",
                "required": ["asset"],
                "properties": {
                  "asset": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
